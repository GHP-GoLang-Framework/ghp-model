<go:import ("fmt")/>

<go
    score := 87
    features := []string{
        "File-based routing with ServeMux patterns",
        "Real Go expressions inside templates",
        "Conditions, loops and switches",
    }
    count := len(features)
/>

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Features — GHP</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      margin: 0;
      padding: 2rem;
      background: #0f172a;
      color: #f1f5f9;
    }
    .card {
      max-width: 40rem;
      margin: 2rem auto;
      padding: 2rem;
      background: #1e293b;
      border-radius: 1rem;
    }
    .btn {
      display: inline-block;
      margin: 0.75rem 0.25rem;
      padding: 0.75rem 1.5rem;
      background: #38bdf8;
      color: #0f172a;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
    }
    .btn:hover { background: #7dd3fc; }
    a { color: #7dd3fc; }
  </style>
</head>
<body>
  <main class="card">
    <h1>Features</h1>
    <p><go= fmt.Sprintf("%d templates features are listed below.", count) /></p>

    <h2>Branching</h2>
    <go:if (score >= 90)/>
        <p>Excellent score.</p>
    <go:elif (score >= 70)/>
        <p>Good score.</p>
    <go:else/>
        <p>Keep practicing.</p>
    <go:endif/>

    <h2>Switch</h2>
    <go:switch score/>
      <go:case 90/>
          <p>The top bracket.</p>
      <go:case 87/>
          <p>Exactly the score we set.</p>
      <go:default/>
          <p>Everything else.</p>
    <go:endswitch/>

    <h2>Loops</h2>
    <ul>
    <go:for i, f := range features/>
      <li><go= fmt.Sprintf("%d. %s", i+1, f) /></li>
    <go:endfor/>

    </ul>

    <a class="btn" href="/">Back to home</a>
    <a class="btn" href="/blog">Visit the blog</a>
  </main>
</body>
</html>
