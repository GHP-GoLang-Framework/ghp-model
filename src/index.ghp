<go:import ("fmt")/>

<go
    title := "GHP Template Test Site" />

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><go= fmt.Sprintf("%s — Home", title) /></title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      background: #0f172a;
      color: #f1f5f9;
    }
    .card { text-align: center; }
    .btn {
      display: inline-block;
      margin: 0.75rem 0.25rem;
      padding: 0.75rem 1.5rem;
      background: #38bdf8;
      color: #0f172a;
      font-weight: 600;
      text-decoration: none;
      border-radius: 0.5rem;
    }
    .btn:hover { background: #7dd3fc; }
  </style>
</head>
<body>
  <main class="card">
    <h1><go= fmt.Sprintf("%s — Home", title) /></h1>
    <p>This is the route <code>/</code>. Every page below is a <code>.ghp</code> file on disk.</p>
    <nav>
      <a class="btn" href="/about">About</a>
      <a class="btn" href="/features">Features</a>
      <a class="btn" href="/blog">Blog</a>
      <a class="btn" href="/docs">Docs</a>

    </nav>
    <go:for i := range 100/>
        <div>This is a fucking GO:FOR test: <go= i /></div>
    <go:endfor/>
  </main>

</body>
</html>
